---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getTagList } from "@utils/content-utils";
import { getTagUrl } from "@utils/url-utils";

const tags = await getTagList();
---

<MainGridLayout title="标签" description="按标签浏览文章">
	<section class="card-base px-8 py-7">
		<div class="mb-6">
			<h1 class="text-3xl font-bold text-90 mb-3">标签</h1>
			<p class="text-75 leading-7">用标签快速定位同类笔记与文章。</p>
		</div>

		<div class="flex flex-wrap gap-2">
			{tags.map((tag) => (
				<a
					href={getTagUrl(tag.name)}
					class="btn-regular h-9 rounded-lg px-3 text-sm"
					aria-label={`查看标签：${tag.name}`}
				>
					#{tag.name}
					<span class="ml-2 text-50">{tag.count}</span>
				</a>
			))}
		</div>
	</section>
</MainGridLayout>
